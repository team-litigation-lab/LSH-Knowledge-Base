{
  // A deploy must not wipe the plain-text vars set in the dashboard (PORTAL_URL, KB_CODE_LOGIN):
  // without PORTAL_URL nobody can sign in from the portal, so nobody can contribute.
  "keep_vars": true,
  "name": "lsh-knowledge-base",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  // ⚡ Run next to the databases (TRAINING_DB in Singapore, the Portal's DB in Hong Kong): a request then crosses the ocean
  // once, not once per query. Smart placement never kicked in at this traffic level.
  "placement": { "region": "aws:ap-southeast-1" },
  "d1_databases": [
    { "binding": "TRAINING_DB", "database_name": "lsh-training-activities-db", "database_id": "6d23429e-e69b-413b-b9fe-0e724f7992e7" },
    { "binding": "DB", "database_name": "lshcasemanagementtraining-trainingcrmlogins", "database_id": "9b1afc1b-a26f-4fc2-aadf-acb9e704b75f" }
  ],
  // Course handouts are kept in step with their source in the course repositories (src/sync.js), every hour.
  "triggers": { "crons": ["23 * * * *", "*/10 * * * *"] },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "lshtraining" }
  ]
}
